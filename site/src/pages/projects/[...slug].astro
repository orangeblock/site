---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { formatDate, getProjects } from '../../lib';

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Article title={project.data.title}>
	<time slot="meta" datetime={project.data.date.toISOString()}>{formatDate(project.data.date)}</time>
	<Content />
</Article>
