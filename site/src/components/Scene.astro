---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	/** File name in src/scenes, without extension. */
	name: string;
	alt: string;
	poster?: ImageMetadata;
	caption?: string;
	wide?: boolean;
	aspect?: string;
}

const { name, alt, poster, caption, wide = false, aspect = '16 / 9' } = Astro.props;
---

<figure class:list={[{ wide }]}>
	<div class="scene" style={`aspect-ratio: ${aspect}`} data-scene={name} role="img" aria-label={alt}>
		{poster && <Image src={poster} alt="" widths={[640, 1280]} sizes="(max-width: 909px) 100vw, 877px" />}
		<canvas></canvas>
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.scene {
		position: relative;
		background: var(--surface);
		border: 1px solid var(--border);
	}
	.scene img,
	.scene canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>

<script>
	import type { SceneModule } from '../scenes/types';

	// Each scene (and three.js) is split into its own chunk, fetched only when a scene scrolls into view.
	const modules = import.meta.glob<SceneModule>('../scenes/*.ts');

	const observer = new IntersectionObserver((entries) => {
		for (const entry of entries) {
			const el = entry.target as HTMLElement & { controls?: ReturnType<SceneModule['mount']> };
			if (entry.isIntersecting) {
				if (el.controls) {
					el.controls.start();
				} else if (!el.dataset.loading) {
					el.dataset.loading = 'true';
					const load = modules[`../scenes/${el.dataset.scene}.ts`];
					load?.().then((mod) => {
						el.controls = mod.mount(el.querySelector('canvas')!);
						el.querySelector('img')?.remove();
						el.controls.start();
					});
				}
			} else {
				el.controls?.stop();
			}
		}
	});

	for (const el of document.querySelectorAll('.scene')) observer.observe(el);
</script>
