---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	/** Either src/scenes/<name>.ts or src/scenes/<name>/index.ts. */
	name: string;
	alt: string;
	poster?: ImageMetadata;
	caption?: string;
	wide?: boolean;
	aspect?: string;
	/** `visible` loads the scene when it scrolls into view. `click` waits for the Play button. */
	start?: 'visible' | 'click';
	/** Adds an empty layer over the canvas, handed to the scene as its second `mount` argument, for scenes that build their own controls on top of it. */
	panel?: boolean;
}

const { name, alt, poster, caption, wide = false, aspect = '16 / 9', start = 'visible', panel = false } = Astro.props;
---

<figure class:list={[{ wide }]}>
	<div class="stage">
		<div class:list={["scene", { tall: panel }]} style={`aspect-ratio: ${aspect}`} data-scene={name} data-start={start} role="img" aria-label={alt}>
			{poster && <Image src={poster} alt="" widths={[640, 1280]} sizes="(max-width: 909px) 100vw, 877px" />}
			<canvas></canvas>
			{start === 'click' && <button type="button" class="play">▶ Play</button>}
		</div>
		{panel && <div class="panel"></div>}
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.scene {
		position: relative;
		background: var(--surface);
		border: 1px solid var(--border);
	}
	.scene img,
	.scene canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.scene canvas {
		outline: none;
	}
	.play {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: grid;
		place-items: center;
		padding: 0;
		border: 0;
		background: none;
		color: var(--text);
		font-family: var(--mono);
		font-size: 14px;
		cursor: pointer;
	}
	.play:hover {
		color: var(--accent);
	}
	.stage {
		position: relative;
	}
	/* A scene with controls laid over it needs more height on a phone, where the controls take a large share of the screen. */
	@media (max-width: 640px) {
		.tall {
			aspect-ratio: 3 / 4 !important;
		}
	}
	/* Covers the scene. It ignores the pointer, so the scene's own controls (and the scene itself) stay usable. */
	.panel {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
</style>

<script>
	import type { SceneControls, SceneModule } from '../scenes/types';

	// Each scene (and three.js) is split into its own chunk, fetched only when the scene is first needed.
	const modules = import.meta.glob<SceneModule>(['../scenes/*.ts', '../scenes/*/index.ts']);

	type SceneElement = HTMLElement & { controls?: SceneControls; visible?: boolean };

	async function load(el: SceneElement) {
		if (el.controls || el.dataset.loading) return;
		el.dataset.loading = 'true';
		const name = el.dataset.scene;
		const load = modules[`../scenes/${name}.ts`] ?? modules[`../scenes/${name}/index.ts`];
		const mod = await load?.();
		if (!mod) return;
		const panel = el.parentElement!.querySelector<HTMLElement>('.panel');
		el.controls = mod.mount(el.querySelector('canvas')!, panel!);
		el.querySelectorAll('img, .play').forEach((node) => node.remove());
		if (el.visible) el.controls.start();
	}

	const observer = new IntersectionObserver((entries) => {
		for (const entry of entries) {
			const el = entry.target as SceneElement;
			el.visible = entry.isIntersecting;
			// A click-to-start scene stays unloaded until its Play button is pressed.
			if (!el.controls && el.dataset.start === 'click') continue;
			if (!entry.isIntersecting) el.controls?.stop();
			else if (el.controls) el.controls.start();
			else load(el);
		}
	});

	for (const el of document.querySelectorAll<SceneElement>('.scene')) {
		observer.observe(el);
		el.querySelector('.play')?.addEventListener('click', (event) => {
			(event.currentTarget as HTMLButtonElement).textContent = 'Loading…';
			load(el);
		});
	}
</script>
