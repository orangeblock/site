---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
	src: ImageMetadata | string;
	alt: string;
	caption?: string;
	wide?: boolean;
}

const { src, alt, caption, wide = false } = Astro.props;
const sizes = wide ? '(max-width: 909px) calc(100vw - 32px), 877px' : '(max-width: 653px) calc(100vw - 32px), 621px';
---

<figure class:list={[{ wide }]}>
	{
		typeof src === 'string' ? (
			<img src={src} alt={alt} loading="lazy" decoding="async" />
		) : (
			<Picture src={src} alt={alt} formats={['avif', 'webp']} widths={[640, 960, 1280, 1760]} sizes={sizes} />
		)
	}
	{caption && <figcaption>{caption}</figcaption>}
</figure>
