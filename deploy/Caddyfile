datdan.net {
	root * /var/www/site
	encode zstd gzip
	file_server

	# Astro puts content-hashed files in /_astro/, so they never change once published.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@unhashed not path /_astro/*
	header @unhashed Cache-Control "no-cache"
}

www.datdan.net {
	redir https://datdan.net{uri} permanent
}
